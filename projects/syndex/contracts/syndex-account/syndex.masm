export.register_institution
    debug.stack
    # Stack: [] (depth 0)

    # Read schema hash and institution id from advice provider.
    adv_pushw
    # Stack: [SH3, SH2, SH1, SH0] (depth 4)
    adv_push
    # Stack: [ID, SH3, SH2, SH1, SH0] (depth 5)

    # Persist schema hash at slot 0.
    push.0
    movup.5
    # Stack: [SH0, 0, ID, SH3, SH2, SH1] (depth 6)
    # Note: account::set_item expects [index, v3, v2, v1, v0]
    # We need to rearrange to [0, SH3, SH2, SH1, SH0]
    movup.3
    movup.3
    movup.3
    # Stack: [0, SH3, SH2, SH1, SH0, ID] (depth 6)
    account::set_item
    # Stack: [OLD_W3, OLD_W2, OLD_W1, OLD_W0, ID] (depth 5)
    dropw
    # Stack: [ID] (depth 1)

    # Persist institution id at slot 1.
    push.1
    movup.1
    # Stack: [ID, 1] (depth 2)
    swap
    padw
    # Stack: [0, 0, 0, ID, 1] (depth 5)
    movup.4
    # Stack: [1, 0, 0, 0, ID] (depth 5)
    account::set_item
    dropw
    # Stack: [] (depth 0)

    # Initialize model root (slot 2) to zero word.
    push.2
    push.0
    push.0
    push.0
    push.0
    # Stack: [0, 0, 0, 0, 2] (depth 5)
    movup.4
    account::set_item
    dropw

    # Initialize participant count (slot 3) to 0.
    push.3
    push.0
    padw
    # Stack: [0, 0, 0, 0, 3] (depth 5)
    movup.4
    account::set_item
    dropw

    debug.stack
    # Stack: [] (depth 0)
end

export.submit_gradient_update
    debug.stack
    # Stack: [] (depth 0)

    # Read gradient hash, validity proof hash, and institution id.
    adv_pushw
    # Stack: [G3, G2, G1, G0] (depth 4)
    adv_pushw
    # Stack: [P3, P2, P1, P0, G3, G2, G1, G0] (depth 8)
    adv_push
    # Stack: [ID, P3, P2, P1, P0, G3, G2, G1, G0] (depth 9)

    # Verify institution id against slot 1.
    push.1
    account::get_item
    # Stack: [0, 0, 0, STORED_ID, ID, P3, P2, P1, P0, G3, G2, G1, G0] (depth 13)
    movup.4
    # Stack: [ID, 0, 0, 0, STORED_ID, P3, P2, P1, P0, G3, G2, G1, G0] (depth 13)
    movup.4
    # Stack: [STORED_ID, ID, 0, 0, 0, P3, P2, P1, P0, G3, G2, G1, G0] (depth 13)
    assert_eq
    # Stack: [0, 0, 0, P3, P2, P1, P0, G3, G2, G1, G0] (depth 11)
    drop
    drop
    drop
    # Stack: [P3, P2, P1, P0, G3, G2, G1, G0] (depth 8)

    # In a real ZK circuit, we would verify the proof here.
    # For now, we drop the proof and keep the gradient.
    dropw
    # Stack: [G3, G2, G1, G0] (depth 4)

    # Load current model root and XOR with gradient hash.
    push.2
    account::get_item
    # Stack: [R3, R2, R1, R0, G3, G2, G1, G0] (depth 8)
    
    # Simple XOR aggregation (placeholder for RPO hash fold)
    # We XOR each element of the word.
    movup.4
    xor
    movup.4
    xor
    movup.4
    xor
    movup.4
    xor
    # Stack: [NEW_R0, NEW_R1, NEW_R2, NEW_R3] (depth 4)
    # Note: We need to store it as a word [R3, R2, R1, R0]
    swap.3
    swap.1
    # Stack: [NEW_R3, NEW_R2, NEW_R1, NEW_R0] (depth 4)

    # Store new model root in slot 2.
    push.2
    movup.4
    movup.4
    movup.4
    movup.4
    account::set_item
    dropw

    # Increment participant count in slot 3.
    push.3
    account::get_item
    # Stack: [0, 0, 0, COUNT] (depth 4)
    drop
    drop
    drop
    add.1
    # Stack: [NEW_COUNT] (depth 1)
    push.3
    swap
    padw
    # Stack: [0, 0, 0, NEW_COUNT, 3] (depth 5)
    movup.4
    account::set_item
    dropw

    debug.stack
    # Stack: [] (depth 0)
end

export.pull_model
    debug.stack
    # Stack: [] (depth 0)

    # Read model root and participant count from storage.
    push.2
    account::get_item
    # Stack: [R3, R2, R1, R0] (depth 4)
    push.3
    account::get_item
    # Stack: [0, 0, 0, COUNT, R3, R2, R1, R0] (depth 8)

    # Clean stack: keep [COUNT, R3, R2, R1, R0]
    drop
    drop
    drop
    # Stack: [COUNT, R3, R2, R1, R0] (depth 5)

    debug.stack
end
